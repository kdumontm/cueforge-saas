# Variables d'env pour le service frontend staging sur Railway.
# À configurer dans Railway UI — ce fichier est un template.

# Active la StagingBanner
NEXT_PUBLIC_ENV=staging

# URL du backend staging (à remplacer par l'URL réelle après création du service)
BACKEND_INTERNAL_URL=https://cueforge-backend-staging.up.railway.app
NEXT_PUBLIC_API_URL=https://cueforge-backend-staging.up.railway.app

# Sentry séparé staging (optionnel — peut utiliser même DSN + SENTRY_ENVIRONMENT=staging)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
